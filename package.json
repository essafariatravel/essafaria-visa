{
  "name": "essafaria-visa-os",
  "version": "0.3.0",
  "private": true,
  "description": "ESSAFARIA VISA OS — configurable B2B visa operations platform",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf .data storage && npm run db:migrate && npm run db:seed",
    "secrets:scan": "tsx scripts/secret-scan.ts",
    "outbox:drain": "tsx scripts/dispatch-outbox.ts",
    "automation:run": "tsx scripts/run-automation.ts",
    "smoke:pages": "tsx scripts/smoke-pages.ts",
    "probe:seed": "tsx scripts/verification/seed-second-tenant.ts",
    "probe:http": "bash scripts/verification/http-probe.sh",
    "test:postgres": "TEST_DB=postgres vitest run",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "verify:concurrency": "tsx scripts/concurrency-check.ts",
    "db:demo": "tsx scripts/verification/seed-demo-files.ts",
    "vercel-build": "node scripts/vercel-build.cjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "clsx": "2.1.1",
    "drizzle-orm": "0.36.4",
    "next": "14.2.15",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.28.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
