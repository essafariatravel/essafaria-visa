# Copy to .env and fill in. `.env` is gitignored and is read by `npm run dev`,
# `npm start` and every script in package.json.
#
# The app validates this against a strict schema (src/lib/env.ts): an unknown variable
# is ignored, a malformed one stops the app from booting. `npm run deploy:check` —
# which also runs on every container start — reports the same contract before you
# trust a deploy. Nothing here is a working secret.

# --- database ---------------------------------------------------------------------
# Set DATABASE_URL and the app uses PostgreSQL. With DATABASE_MODE=pglite and no URL it
# uses the embedded store in .data/pgdata — development, tests and sandboxes only:
# it is single-writer, two processes cannot share it, and it is NOT a production target.
DATABASE_MODE=postgres
DATABASE_URL=postgresql://essafaria@localhost:5432/essafaria
# (real deployments embed the password in the URL, or use a .pgpass / pgbouncer
#  auth plugin — this example stays credential-free on purpose)
# used by docker-compose.yml to create the database above
POSTGRES_DB=essafaria
POSTGRES_USER=essafaria
POSTGRES_PASSWORD=CHANGE_ME

# --- app --------------------------------------------------------------------------
# absolute origin, no trailing slash; used in email links and to reject foreign Host
APP_URL=http://localhost:3000
# On Vercel APP_URL may be omitted; the app derives it from VERCEL_URL.
APP_PORT=3000
# AES key that seals Gmail refresh tokens and other stored credentials.
# Generate once and back it up — rotating it forces every mailbox to be re-authorised.
# generate:  openssl rand -base64 32
ESF_TOKEN_KEY=copy-the-output-of-that-command
# "true" | "false" — string booleans, not 1/0
REQUIRE_HTTPS=false
# "false" means the process is exposed directly and X-Forwarded-* must be ignored;
# leave it "true" only when a trusted proxy sets and strips those headers.
TRUST_PROXY_HEADERS=false

# --- storage ----------------------------------------------------------------------
# uploaded document bytes live here (never in PostgreSQL); keep it on durable storage
MEDIA_ROOT=./media
# local = localhost only; supabase = persistent Vercel storage
MEDIA_PROVIDER=local
# On Vercel set MEDIA_PROVIDER=supabase and provide these server-only values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=essafaria-media

# --- outbound email ---------------------------------------------------------------
# "none" | "file" | "log" | "smtp" — note that "log" is an alias for "file"
# both "file" and "log" write .eml under MEDIA_ROOT/outbox and send nothing.
# "smtp" needs SMTP_URL or SENDGRID_API_KEY *and* a provider client installed
# (see DEPLOYMENT.md §4 — this build ships the queue, not a vendor SDK).
EMAIL_TRANSPORT=log
SMTP_URL=
SENDGRID_API_KEY=

# --- rate limiting / brute force --------------------------------------------------
RATE_LIMIT_PER_MINUTE=240
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# --- AI assistant (advisory only — it never approves or refuses an application) ----
# "rules" = deterministic, no external calls. A vendor provider needs AI_API_KEY_REF.
AI_PROVIDER=rules
AI_MODEL=
AI_BASE_URL=
# NAME of the env var that holds the key — never the key itself
AI_API_KEY_REF=
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=30000

# --- Gmail intake -----------------------------------------------------------------
GMAIL_ENABLED=false
# "none" | "fixture" (replays recorded messages, no credentials) | "google"
GMAIL_PROVIDER=fixture
# both hold the NAME of the env var that carries the value, never the value
GMAIL_CLIENT_ID_REF=
GMAIL_CLIENT_SECRET_REF=
GMAIL_REDIRECT_URI=
GMAIL_TOKEN_KEY_REF=ESF_TOKEN_KEY
GMAIL_POLL_QUERY=is:unread

# --- background jobs (one process each; see DEPLOYMENT.md §3) ----------------------
OUTBOX_LIMIT=50
AUTOMATION_TASK=
AUTOMATION_FORCE=

# --- one-off bootstrap (fresh staging database only; never on production) ---------
# `npm run db:seed` is idempotent: existing rows are skipped, never overwritten.
SEED_ADMIN_PASSWORD=
SEED_AGENCY_PASSWORD=
